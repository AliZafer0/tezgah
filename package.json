{
  "name": "tezgah",
  "version": "1.0.0",
  "private": true,
  "description": "Türk sanatlarını koda döken etkileşimli web deneyleri: kilim, girih, makam, hat… Canvas, WebGL ve Web Audio ile, bağımlılıksız.",
  "author": "AliZafer (https://github.com/AliZafer0)",
  "license": "MIT",
  "homepage": "https://py.execore.cloud/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AliZafer0/tezgah.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "dev": "node scripts/server.mjs --dev",
    "build": "node scripts/build.mjs",
    "build:projects": "node scripts/build.mjs --projects-only",
    "start": "node scripts/server.mjs",
    "create:project": "node scripts/create-project.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "node tests/e2e/hub.e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "playwright-core": "1.64.0",
    "vite": "8.3.4"
  }
}
